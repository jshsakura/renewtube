{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.17.2",
  "default_locale": "en",
  "author": "OpenCourse",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "exclude_matches": [
        "https://music.youtube.com/*"
      ]
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false,
      "exclude_matches": [
        "https://music.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "main.js"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}
